# Copiar a `.env` y completar. `.env` está en .gitignore: nunca commitear
# credenciales reales. En la VM no hay .env: los valores llegan como podman
# secrets (ba-aire/infra, secrets/README.md). La app de Vercel vive en la rama
# `vercel` y tiene su propio .env.example.

# Connection string de PostgreSQL: la base `portal` del cluster de TimescaleDB
# en la VM (ver docs/portal.md en ba-aire/infra). Para desarrollo local sirve
# cualquier Postgres, Neon incluido. Formato:
#   postgresql://<user>:<password>@<host>:5432/<db>
# En la VM: postgresql://portal:PASS@timescaledb:5432/portal?sslmode=disable
# (no sale de la red de podman). Contra Neon, agregar ?sslmode=require.
# La leen db/drizzle.ts (app) y drizzle.config.ts (drizzle-kit), y ambos
# tiran error al arrancar si falta.
DATABASE_URL=

# Clave para firmar y verificar los JWT de sesión (HS256, cookie httpOnly,
# 7hs de expiración). lib/auth-session.ts la toma como texto plano y la
# codifica con TextEncoder, así que HS256 pide 32 caracteres como mínimo.
# Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cambiarla invalida todas las sesiones activas.
SESSION_SECRET=

# Token de lectura de InfluxDB Cloud, para las series de contaminantes
# ({pollutant}_minutales). Se genera en InfluxDB Cloud > Load Data > API
# Tokens; alcanza con permiso de lectura.
# El host NO va acá: está fijo en db/influx.ts.
INFLUXDB_TOKEN=
