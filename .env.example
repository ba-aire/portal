# Copiar a `.env` y completar. `.env` está en .gitignore: nunca commitear
# credenciales reales. En la VM no hay .env: los valores llegan como podman
# secrets (ba-aire/infra, secrets/README.md).

# Connection string de PostgreSQL: la base `portal` del cluster de TimescaleDB
# en la VM (ver docs/portal.md en ba-aire/infra). Para desarrollo local sirve
# cualquier Postgres, Neon incluido. Formato:
#   postgresql://<user>:<password>@<host>:5432/<db>
# En la VM: postgresql://portal:PASS@timescaledb:5432/portal?sslmode=disable
# (no sale de la red de podman). Contra Neon, agregar ?sslmode=require.
# La leen db/drizzle.ts (app) y drizzle.config.ts (drizzle-kit), y ambos
# tiran error al arrancar si falta.
DATABASE_URL=

# Connection string de airedb, el archivo regulatorio (bronze, silver, gold, dim).
# Mismo rol `portal`, que ahí solo puede leer (V12 en ba-aire/data). La lee
# db/airedb.ts recién en la primera consulta, así el build no la necesita.
# En la VM: postgresql://portal:PASS@timescaledb:5432/airedb?sslmode=disable
# Local: scripts/dev-db.sh deja lista una réplica sobre el stack de dev de data y
# te imprime esta URL y la de DATABASE_URL.
AIREDB_URL=

# Clave para firmar y verificar los JWT de sesión (HS256, cookie httpOnly,
# 7hs de expiración). lib/auth-session.ts la toma como texto plano y la
# codifica con TextEncoder, así que HS256 pide 32 caracteres como mínimo.
# Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cambiarla invalida todas las sesiones activas.
SESSION_SECRET=

# Impresión del reporte mensual en PDF (lib/reportes/impresion.ts). El PDF lo
# imprime Chromium en Gotenberg, un contenedor aparte: el portal le pasa la URL
# de /imprimir/reporte-mensual con un token de dos minutos firmado con
# SESSION_SECRET. Sin estas dos, el PDF responde 503 (la vista en HTML anda igual).
# Local: docker run --rm -p 127.0.0.1:3001:3000 gotenberg/gotenberg:8
#   GOTENBERG_URL=http://localhost:3001
#   PORTAL_URL_INTERNA=http://host.docker.internal:3000
# En la VM: los nombres de los contenedores en la red de podman.
# PORTAL_URL_INTERNA va SIN el basePath (/portal): lo agrega el portal.
GOTENBERG_URL=
PORTAL_URL_INTERNA=
