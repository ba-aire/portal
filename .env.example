# Copiar a `.env` y completar. `.env` está en .gitignore: nunca commitear
# credenciales reales. En Vercel estas tres viven en Project Settings >
# Environment Variables del proyecto `sirca-frontend`.

# Connection string de PostgreSQL (Neon). Formato:
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require
# Se saca del dashboard de Neon > Connection Details. Usar el endpoint
# pooled (-pooler) para runtime serverless.
# La leen db/drizzle.ts (app) y drizzle.config.ts (drizzle-kit), y ambos
# tiran error al arrancar si falta.
DATABASE_URL=

# Clave para firmar y verificar los JWT de sesión (HS256, cookie httpOnly,
# 7hs de expiración). lib/auth-session.ts la toma como texto plano y la
# codifica con TextEncoder, así que HS256 pide 32 caracteres como mínimo.
# Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cambiarla invalida todas las sesiones activas.
SESSION_SECRET=

# Token de lectura de InfluxDB Cloud, para las series de contaminantes
# ({pollutant}_minutales). Se genera en InfluxDB Cloud > Load Data > API
# Tokens; alcanza con permiso de lectura.
# El host NO va acá: está fijo en db/influx.ts.
INFLUXDB_TOKEN=
